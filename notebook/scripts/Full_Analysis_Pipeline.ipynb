# %% [markdown]
# # Section 1: Environment Setup & Data Integrity Verification
# Loading dependencies, setting deterministic seeds, and importing student-draft pairs.

# %%
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Set scientific plotting parameters
sns.set_theme(style="ticks", palette="colorblind")
plt.rcParams['font.family'] = 'DejaVu Sans'
plt.rcParams['figure.dpi'] = 300

DATA_PATH = "data/processed/combined_results.csv"
df = pd.read_csv(DATA_PATH)
print(f"Loaded {len(df)} essay pairs across {df['StudentID'].nunique()} unique participants.")

# %% [markdown]
# # Section 2: Multidimensional Textual & Syntactic Profiling
# Computing length-invariant lexical diversity (MTLD/HD-D), phrasal complexity (Lu, 2010),
# and Stance Metadiscourse markers (Hyland, 2005).

# %%
from scripts.syntactic_complexity_lu2010 import compute_syntactic_indices
from scripts.lexical_diversity_mtld_hdd import compute_mtld, compute_hdd

print("Extracting lexical diversity and syntactic complexity...")
df['MTLD_indep'] = df['text_indep'].apply(compute_mtld)
df['MTLD_ai'] = df['text_ai'].apply(compute_mtld)

syn_indep = pd.DataFrame(list(df['text_indep'].apply(compute_syntactic_indices))).add_suffix('_indep')
syn_ai = pd.DataFrame(list(df['text_ai'].apply(compute_syntactic_indices))).add_suffix('_ai')
df = pd.concat([df, syn_indep, syn_ai], axis=1)

# %% [markdown]
# # Section 3: Linear Mixed-Effects (LME) Modeling
# Bridging to R for rigorous nested-effects estimation:
# Formula: Metric ~ Condition * Proficiency + (1 + Condition | StudentID)

# %%
# Load rpy2 extension for R execution within Jupyter
%load_ext rpy2.ipython

# %% R -i df
suppressPackageStartupMessages({
    library(lme4)
    library(lmerTest)
    library(emmeans)
    library(performance)
})

# Convert relevant factors
df$Condition <- as.factor(df$Condition)
df$Proficiency <- as.factor(df$Proficiency)

# Fit mixed model for MTLD
lme_mtld <- lmer(MTLD ~ Condition * Proficiency + (1 + Condition | StudentID), data = df)
summary(lme_mtld)

# Pairwise estimated marginal means
emmeans(lme_mtld, pairwise ~ Condition | Proficiency)

# %% [markdown]
# # Section 4: Stylistic Homogenization & Identity Compression
# Calculating inter-author Cosine Similarity via SBERT embeddings and Permutation Tests.

# %%
from scripts.stylistic_homogenization_analysis import compute_sbert_similarity_matrix, permutation_homogenization_test

sim_indep, sim_ai = compute_sbert_similarity_matrix(df['text_indep'], df['text_ai'])
perm_p_val, effect_size = permutation_homogenization_test(sim_indep, sim_ai, n_permutations=10000)

print(f"Stylistic Homogenization: Permutation p-value = {perm_p_val:.4e}, Cohen's d = {effect_size:.3f}")

# %% [markdown]
# # Section 5: Psychological-Linguistic Bridge (AGS Correlation)
# Correlating text-level modifications (Valence Shift, De-subjectification, Levenshtein Distance)
# with perceived Authenticity Gap Scores (AGS).

# %%
from scripts.correlation_and_ags_analysis import generate_ags_masked_heatmap

metrics_to_correlate = [
    'valence_shift_abs', 'neutralization_index', 
    'wer_edit_distance', 'MTLD_ai', 'CN_C_ai'
]
generate_ags_masked_heatmap(df, metrics_to_correlate, ags_col='AGS_score')

# %% [markdown]
# # Section 6: Corpus Keyness & Contrastive Lexical Visualizations
# Identifying suppressed vs. injected vocabulary using Log-Likelihood (G^2).

# %%
from scripts.corpus_keyness_and_contrastive_viz import calculate_keyness_table, plot_contrastive_visuals

# Execute keyness and save publication-grade visual assets
keyness_df = calculate_keyness_table(df['text_indep'], df['text_ai'])
plot_contrastive_visuals(keyness_df, top_k=15)
